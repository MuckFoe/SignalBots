SIGNAL_BOT_NUMBER=+491701234567
SIGNAL_API_URL=http://localhost:8080
CHORE_BOT_URL=http://localhost:5000
RENTAL_BOT_URL=http://localhost:5001
EXPENSE_BOT_URL=http://localhost:5002
BOT_HOST=0.0.0.0
BOT_PORT=5100
DATABASE_PATH=router.db
INCOMING_MAX_AGE_SECONDS=300

POLL_TIMES=08:00,20:00

BOT_INSTANCE_ID=default
BOT_INSTANCE_NAME=House Bot

# --- chore-bot: local LLM command assist (see docs/llm-command-assist-plan.md) ---
# Off unless LLM_ENABLED=true. Use the Mac mini's LAN IP, not a .local name.
LLM_ENABLED=false
LLM_BASE_URL=http://192.168.178.XX:11434/v1
LLM_MODEL=qwen3.6:35b
LLM_TIMEOUT_SECONDS=8
# Comma-separated scope ids that may use the LLM; empty = all chats.
LLM_SCOPES=
# In groups, ignore LLM answers below this confidence (keeps the bot quiet on chatter).
LLM_GROUP_MIN_CONFIDENCE=0.6

# --- Local deploy/check scripts only (not used by the containers) ---
# Consumed by ssh_config.py. Copy this file to .env and fill in real values.
SSH_HOST=192.168.1.10
SSH_USER=youruser
SSH_PASSWORD=changeme
# Optional: only if the root password differs from SSH_PASSWORD.
SSH_ROOT_PASSWORD=
REMOTE_ROOT=/home/signalbot/ProjectHub
# Sender identity used by the check_bots.py smoke tests.
TEST_SENDER=+491701234567
